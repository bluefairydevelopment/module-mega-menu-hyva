<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        M2MAP-230. Registers view/frontend/tailwind with Hyva's config generator
        so the theme's Tailwind build scans this module's templates. Without it
        every utility class appearing ONLY here is purged from the compiled CSS
        and the element renders as though the class had never been written - no
        console error, no 404.

        REGISTERING IS NOT SUFFICIENT ON ITS OWN. This only puts the module into
        the generator's INPUT. Per install, after deploying:
            bin/magento hyva:config:generate
            cd <theme>/web/tailwind && npm ci && npm run build
            bin/magento cache:flush
    -->
    <event name="hyva_config_generate_before">
        <observer name="BlueFairy_MegaMenuHyva" instance="BlueFairy\MegaMenuHyva\Observer\RegisterModuleForHyvaConfig"/>
    </event>
</config>
